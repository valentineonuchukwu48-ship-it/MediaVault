# Never ship these into the image — they are either rebuilt or host-specific.
node_modules
dist
.git
.gitignore

# Local secrets
.env
.env.*
!.env.example

# Runtime/generated data (must not be baked into the image)
vault
public/uploads
public/audio
*.log
server.log
npm-install.log

# Platform-specific binary — the image installs the Linux build instead
yt-dlp.exe

# Editor / OS noise
.DS_Store
Thumbs.db
