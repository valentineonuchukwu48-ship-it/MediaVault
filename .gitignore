node_modules/
build/
dist/
coverage/
.DS_Store
Thumbs.db
*.log
server.log
npm-install.log

# Local secrets — never commit. Keep the example only.
.env*
!.env.example

# Runtime / generated data
# (the desktop app writes all of this under the user's profile, but the repo
#  keeps the same names ignored so local runs stay clean)
vault/
data/
.test-data/
public/uploads/
public/audio/
bin/
release/

# Cookies / secret material
cookies.txt
secrets/

# Platform-specific binary. Builds fetch the correct yt-dlp/ffmpeg for their OS
# via `npm run fetch:binaries`; never commit the binaries.
yt-dlp.exe
yt-dlp
ffmpeg
ffmpeg.exe
ffprobe
ffprobe.exe
