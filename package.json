{
  "name": "mediavault",
  "productName": "Ultimate Media Vault",
  "private": true,
  "version": "2.0.0",
  "description": "Your private media vault: archive Facebook posts to tamper-evident PDFs, download and merge videos — everything stays on your own machine.",
  "author": {
    "name": "Valentine Onuchukwu",
    "email": "valentineonuchukwu@gmail.com",
    "url": "https://flutterwave.com/donate/fysqhtbnfznn"
  },
  "company": "ProsperChild Technology",
  "contributors": [
    "Valentine Onuchukwu — ProsperChild Technology"
  ],
  "funding": {
    "type": "individual",
    "url": "https://flutterwave.com/donate/fysqhtbnfznn"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "desktop": "npm run build && npm run build:server && electron .",
    "desktop:dev": "npm run build:server && cross-env FGC_FORCE_DEV=1 electron .",
    "dist": "npm run build && npm run build:server && electron-builder",
    "dist:win": "npm run build && npm run build:server && electron-builder --win",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:server && electron-builder --linux",
    "pack:dir": "npm run build && npm run build:server && electron-builder --dir",
    "release": "npm run build && npm run build:server && electron-builder --publish always",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "exifreader": "^4.50.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opentimestamps": "^0.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
